# Hugging Face Token (Required for gated dataset TokyoTechMagicYang/RAM-H1200-v1)
HF_TOKEN=your_huggingface_token_here

# Database Configuration (PostgreSQL in production, SQLite fallback for local development)
DATABASE_URL=sqlite:///./xray_rheumatology.db
# DATABASE_URL=postgresql://postgres:postgres@db:5432/rheumatology_ai

# Authentication & Security
JWT_SECRET_KEY=change-this-in-production-rheumatology-xray-secret-key-2026
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Storage & Paths
STORAGE_DIR=storage
REPORTS_DIR=reports
MODELS_DIR=models
CONFIG_PATH=configs/config.yaml

# Frontend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000
